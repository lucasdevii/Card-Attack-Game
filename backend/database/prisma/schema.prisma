generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum userStates {
  OFFLINE
  ONLINE
  SEARCHING
  IN_GAME
}

model cards {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(100)
  description   String        @db.VarChar(255)
  attack        Int?          @default(0)
  life          Int?          @default(2)
  defense       Int?          @default(0)
  cost          Int?          @default(0)
  image         String        @db.VarChar(255)
  users_cards   users_cards[]
}

model users {
  id            Int           @id @default(autoincrement())
  name          String        @db.VarChar(100)
  email         String        @unique @db.VarChar(100)
  password      String        @db.VarChar(100)
  elo           Int?          @default(0)
  status        userStates    @default(OFFLINE)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @default(now())
  users_cards   users_cards[]
  user_matches  match_players[]
}

model users_cards {
  user_id       Int
  card_id       Int
  current_level Int?          @default(0)
  current_exp   Int?          @default(0)
  cards         cards         @relation(fields: [card_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users         users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([user_id, card_id])
}

model match_players {
  id            Int           @id @default(autoincrement())
  match_code    String        @unique @default(uuid())
  user_id       Int         
  match_id      Int
  user          users         @relation(fields: [user_id], references: [id])
  match         matches       @relation(fields: [match_id], references: [id])
}
model matches {
  id            Int           @id @default(autoincrement())
  room_code     String        @unique
  finished      Boolean       @default(false)
  winner        Int?          //id do jogador
  in_game       Boolean       @default(true)
  players       match_players[]
}
